FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0]; // 온도의 차원(Kelvin)

internalField   uniform REPLACE_MOLD_TEMPERATURE_K; // 내부 초기 온도

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform REPLACE_MELT_TEMPERATURE_K; // 사출기 노즐에서 들어오는 수지 온도
    }
    walls
    {
        type            fixedValue;
        value           uniform REPLACE_MOLD_TEMPERATURE_K; // 금형 벽면의 온도
    }
    outlet
    {
        type            zeroGradient;
    }
}
