FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam; // 사용할 솔버 이름

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         REPLACE_END_TIME; // JSON에서 받아온 총 시뮬레이션 시간

deltaT          0.005; // 타임 스텝

writeControl    runTime;
writeInterval   0.1; // 결과 저장 주기

