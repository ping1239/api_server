FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (phase1);

phase1
{
    transportModel  CrossWLF;
    
    CrossWLFCoeffs
    {
        n               REPLACE_CROSS_WLF_N;
        tauStar         REPLACE_CROSS_WLF_TAU_PA;
        D1              1.1e13; // default or placeholder
        D2              REPLACE_TRANSITION_TEMPERATURE_K; // e.g. 130 C
        D3              0;
        A1              25.0;
        A2              51.6;
        T0              REPLACE_NO_FLOW_TEMPERATURE_K; // e.g. 110 C
    }
}
